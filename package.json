{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "next dev -H 0.0.0.0 -p 5173",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "dev:local": "next dev -H 0.0.0.0 -p 5173",
    "build:local": "next build",
    "start:local": "next start -H 0.0.0.0 -p 5173",
    "start:docker": "next start -H 0.0.0.0 -p 5173",
    "prestart:docker": "node scripts/migrate.mjs",
    "prestart:local": "node scripts/migrate.mjs",
    "docker:up": "docker compose --env-file .env.local -f docker-compose.local.yml up -d",
    "docker:down": "docker compose --env-file .env.local -f docker-compose.local.yml down",
    "db:generate": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate:local": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:seed:local": "node --env-file=.env.local scripts/seed-local.mjs",
    "storage:reconcile": "node --env-file=.env.local scripts/reconcile-storage.mjs",
    "test:storage": "node --env-file=.env.local scripts/test-storage.mjs",
    "data:health": "node scripts/data-health.mjs",
    "test:unit": "tsx scripts/test-artifact-efficiency.ts && tsx scripts/test-pro-policy.ts && tsx scripts/test-word-fast.ts && tsx scripts/test-upload-policy.ts && tsx scripts/test-delivery-policy.ts && tsx scripts/test-realtime.ts"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "fast-xml-parser": "5.11.2",
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76",
    "unpdf": "2.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
